+AResourceNode* AShamanPlayerController::PickResourceNode(const FVector2D& ScreenPos) const
+{
+	FVector Origin, Dir;
+	if (!DeprojectScreenPositionToWorld(ScreenPos.X, ScreenPos.Y, Origin, Dir)) return nullptr;
+	FHitResult Hit;
+	FCollisionQueryParams Params(TEXT("ShamanRTSPickResource"), true, GetPawn());
+	if (!GetWorld()->LineTraceSingleByChannel(Hit, Origin, Origin + Dir * 500000.f, ECC_Visibility, Params)) return nullptr;
+	AResourceNode* Node = Cast<AResourceNode>(Hit.GetActor());
+	return (Node && !Node->IsPendingKillPending()) ? Node : nullptr;
+}
+
+int32 AShamanPlayerController::CommandGather(const TArray<AShamanUnitBase*>& Units, AResourceNode* Node)
+{
+	if (!Node || Node->IsPendingKillPending()) return 0;
+	RefreshPlayerTribe();
+	const int32 Tribe = GetPlayerTribe();
+	UTribeSubsystem* Tribes = GetWorld() ? GetWorld()->GetSubsystem<UTribeSubsystem>() : nullptr;
+	UTribeComponent* TC = Tribes ? Tribes->GetTribeComponent(Tribe) : nullptr;
+	const FGameplayTag Tag = FGatherRules::TagForResource(Node->GetResourceType());
+	if (!TC || !Tag.IsValid())
+	{
+		UE_LOG(LogShaman, Log, TEXT("[Command] gather: no tribe or Task.Gather tag missing (Config/DefaultGameplayTags.ini)"));
+		return 0;
+	}
+	int32 Ordered = 0, Skipped = 0;
+	for (AShamanUnitBase* U : Units)
+	{
+		if (!FShamanSelectionRules::IsSelectable(U, Tribe) || U->IsShaman()) continue;
+		UTribeMemberComponent* M = U->TribeMember;
+		if (U->GetRow().Role != EUnitRole::Brave || !M) { ++Skipped; continue; } // Populous: only Braves gather
+		if (M->HasTask()) TC->CancelTask(M->GetCurrentTaskId(), TEXT("PlayerCommand"));
+		const int32 Id = TC->CreateTask(Tag, ETribeTaskPriority::High, Node, Node->GetActorLocation(), true, TEXT("PlayerCommand"));
+		const bool bTask = Id != INDEX_NONE && TC->AssignTask(Id, M) && TC->StartTask(Id);
+		FTribeTask T;
+		if (!bTask && Id != INDEX_NONE && TC->GetTask(Id, T) && T.IsOpen()) TC->CancelTask(Id, TEXT("PlayerCommandRefused"));
+		if (!bTask) { ++Skipped; continue; }
+		// When the gathering ends (nothing left nearby) the Brave stays by the last node instead of wandering home.
+		U->SetOrder(EFollowerOrder::HoldPosition, Node->GetActorLocation());
+		++Ordered;
+	}
+	MarkCommand(Node->GetActorLocation(), false);
+	UE_LOG(LogShaman, Log, TEXT("[Command] gather %s at %s: %d Brave(s)%s"), FGatherRules::ResourceName(Node->GetResourceType()), *Node->GetName(),
+		Ordered, Skipped > 0 ? *FString::Printf(TEXT(", %d skipped (only available Braves gather)"), Skipped) : TEXT(""));
+	return Ordered;
+}
