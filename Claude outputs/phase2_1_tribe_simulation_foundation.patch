+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+#include "GameplayTagContainer.h"
+#include "TribeComponent.h"
+#include "TribeMemberComponent.h"
+#include "Tribes/TribeTaskTypes.h"
