+#pragma once
+#include "CoreMinimal.h"
+#include "GameplayTagContainer.h"
+#include "ShamanTypes.h"
+#include "TribeEconomy.generated.h"
+
+/**
+ * Slice 3, milestone 3.1: the tribe economy's shared vocabulary. Kept free of actors so every rule here is pure and
+ * unit-tested on its own (Shaman.Economy.*):
+ *   - FResourceCost: what something costs (buildings and training use it from milestone 3.2 on).
+ *   - FTribeStockpile: what a tribe holds. Owned by UTribeComponent; nothing else stores resources.
+ *   - FResourceStock: harvest / regrow arithmetic of one resource node.
+ *   - FGatherRules: gather task tags and the choice of the next node when the ordered one runs out.
+ *   - FTribeEconomyConfig: tuning (UShamanGameData::Economy).
+ * Quantities are bundles: one Brave trip carries FResourceRow::BundlesPerTrip of them (1 by default, as in Populous).
+ */
+
+/** A price in bundles. Every field defaults to 0 (free). */
+USTRUCT(BlueprintType)
+struct SHAMAN_API FResourceCost
+{
+	GENERATED_BODY()
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Economy", meta=(ClampMin="0")) int32 Wood = 0;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Economy", meta=(ClampMin="0")) int32 Food = 0;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Economy", meta=(ClampMin="0")) int32 Stone = 0;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Economy", meta=(ClampMin="0")) int32 Ore = 0;
+
+	FResourceCost() = default;
+	FResourceCost(int32 InWood, int32 InStone, int32 InOre, int32 InFood = 0) : Wood(InWood), Food(InFood), Stone(InStone), Ore(InOre) {}
+
+	/** Amount of one resource (negative fields count as 0). */
+	int32 Get(EResourceType Type) const;
+	bool IsFree() const;
+	/** "3 wood, 2 stone" ("free" when nothing is charged). */
+	FString ToString() const;
+};
+
+/** Resources a tribe holds. Amounts never go negative; spending is all or nothing. */
+USTRUCT(BlueprintType)
+struct SHAMAN_API FTribeStockpile
+{
+	GENERATED_BODY()
+
+	UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Economy") int32 Wood = 0;
+	UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Economy") int32 Food = 0;
+	UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Economy") int32 Stone = 0;
+	UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Economy") int32 Ore = 0;
+
+	int32 Get(EResourceType Type) const;
+	/** Adds Amount (> 0) of Type. Returns what was added (0 for Amount <= 0). Saturates instead of overflowing. */
+	int32 Add(EResourceType Type, int32 Amount);
+	bool CanAfford(const FResourceCost& Cost) const;
+	/** Takes Cost if every part of it is in stock; otherwise changes nothing and returns false. */
+	bool Spend(const FResourceCost& Cost);
+	int32 Total() const { return Wood + Food + Stone + Ore; }
+	/** "Wood 3  Stone 0  Ore 1  Food 2". */
+	FString ToString() const;
+
+private:
+	int32* Find(EResourceType Type);
+};
+
+/** Harvest and regrow arithmetic of a resource node (AResourceNode keeps the state, this keeps the rules). */
+struct SHAMAN_API FResourceStock
+{
+	/** Takes up to Want (> 0) from Remaining. Returns what was taken; Remaining never goes below 0. */
+	static int32 Take(int32& Remaining, int32 Want);
+	/** Adds up to Amount (> 0) without exceeding Max. Returns what was added. */
+	static int32 Regrow(int32& Remaining, int32 Max, int32 Amount);
+};
+
+/** One node as the next-node choice sees it (FGatherRules::PickNode). */
+struct SHAMAN_API FGatherNodeCandidate
+{
+	/** Distance from the gatherer (nearest wins). */
+	float DistanceFromUnit = 0.f;
+	/** Distance from where the order was given (must be within the search radius). */
+	float DistanceFromOrigin = 0.f;
+	bool bTypeMatches = false;
+	bool bDepleted = false;
+	bool bHasFreeSlot = false;
+};
+
+struct SHAMAN_API FGatherRules
+{
+	/** Task.Gather.Wood / Food / Stone / Ore -> the resource it gathers. False for any other tag. */
+	static bool ResourceOfTag(const FGameplayTag& Tag, EResourceType& OutType);
+	/** The gather task tag for a resource (invalid if the tag is not registered). */
+	static FGameplayTag TagForResource(EResourceType Type);
+	/** Index of the node a gatherer should go to next: the right type, not depleted, with a free slot, within
+	 *  MaxDistanceFromOrigin of the order (<= 0: any distance); the nearest to the unit wins, ties go to the lower
+	 *  index (deterministic). INDEX_NONE when none qualifies. */
+	static int32 PickNode(const TArray<FGatherNodeCandidate>& Candidates, float MaxDistanceFromOrigin);
+	/** "wood", "food", "stone", "ore". */
+	static const TCHAR* ResourceName(EResourceType Type);
+};
+
+/** Economy tuning (DA_ShamanGameData > Economy). Node yields, harvest times and regrowth live in DT_Resources. */
+USTRUCT(BlueprintType)
+struct SHAMAN_API FTribeEconomyConfig
+{
+	GENERATED_BODY()
+
+	/** When the node a Brave was sent to runs out (or its slots are full), the Brave moves on to the nearest node of
+	 *  the same kind within this distance of the original order. Nothing in range: the gather order completes. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Economy", meta=(ClampMin="0")) float NodeSearchRadius = 3000.f;
+	/** What every tribe holds at level start (0 everywhere by default: Braves must gather everything). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Economy") FResourceCost StartingStockpile;
+};
