+#define SHAMAN_ECONOMY_TEST(Class, Name) IMPLEMENT_SIMPLE_AUTOMATION_TEST(Class, Name, EAutomationTestFlags::ApplicationContextMask | EAutomationTestFlags::ProductFilter)
+
+SHAMAN_ECONOMY_TEST(FShamanEconomyStockpileTest, "Shaman.Economy.Stockpile")
+bool FShamanEconomyStockpileTest::RunTest(const FString& Parameters)
+{
+	FTribeStockpile S;
+	TestEqual(TEXT("Starts empty"), S.Total(), 0);
+	TestEqual(TEXT("Add returns what was added"), S.Add(EResourceType::Wood, 5), 5);
+	TestEqual(TEXT("Negative add is refused"), S.Add(EResourceType::Wood, -3), 0);
+	TestEqual(TEXT("Zero add is refused"), S.Add(EResourceType::Stone, 0), 0);
+	S.Add(EResourceType::Stone, 2);
+	S.Add(EResourceType::Ore, 1);
+	TestTrue(TEXT("Amounts by type"), S.Get(EResourceType::Wood) == 5 && S.Get(EResourceType::Stone) == 2 && S.Get(EResourceType::Ore) == 1
+		&& S.Get(EResourceType::Food) == 0);
+
+	const FResourceCost Hut(3, 0, 0);
+	const FResourceCost Tower(4, 2, 0);
+	const FResourceCost TooMuch(1, 3, 0);
+	TestTrue(TEXT("Can afford a Small Hut"), S.CanAfford(Hut));
+	TestFalse(TEXT("Cannot afford 3 stone with 2"), S.CanAfford(TooMuch));
+	TestFalse(TEXT("Spend is all or nothing"), S.Spend(TooMuch));
+	TestTrue(TEXT("Failed spend changes nothing"), S.Get(EResourceType::Wood) == 5 && S.Get(EResourceType::Stone) == 2);
+	TestTrue(TEXT("Spend a Guard Tower"), S.Spend(Tower));
+	TestTrue(TEXT("Tower taken"), S.Get(EResourceType::Wood) == 1 && S.Get(EResourceType::Stone) == 0 && S.Get(EResourceType::Ore) == 1);
+	TestTrue(TEXT("Free cost always affordable"), S.Spend(FResourceCost()) && FResourceCost().IsFree());
+	FResourceCost Odd; Odd.Wood = -4;
+	TestEqual(TEXT("Negative cost fields count as 0"), Odd.Get(EResourceType::Wood), 0);
+	TestEqual(TEXT("Cost text"), Tower.ToString(), FString(TEXT("4 wood, 2 stone")));
+	TestEqual(TEXT("Free text"), FResourceCost().ToString(), FString(TEXT("free")));
+
+	FTribeStockpile Big;
+	Big.Add(EResourceType::Food, MAX_int32 - 1);
+	TestEqual(TEXT("Saturates instead of overflowing"), Big.Add(EResourceType::Food, 10), 1);
+	TestEqual(TEXT("At the cap"), Big.Get(EResourceType::Food), MAX_int32);
+	return true;
+}
+
+SHAMAN_ECONOMY_TEST(FShamanEconomyResourceStockTest, "Shaman.Economy.ResourceStock")
+bool FShamanEconomyResourceStockTest::RunTest(const FString& Parameters)
+{
+	int32 Remaining = 4;
+	TestEqual(TEXT("Take 1"), FResourceStock::Take(Remaining, 1), 1);
+	TestEqual(TEXT("Take more than left takes the rest"), FResourceStock::Take(Remaining, 10), 3);
+	TestEqual(TEXT("Empty"), Remaining, 0);
+	TestEqual(TEXT("Nothing from an empty node"), FResourceStock::Take(Remaining, 1), 0);
+	TestEqual(TEXT("Want <= 0 takes nothing"), FResourceStock::Take(Remaining, 0), 0);
+	TestEqual(TEXT("Regrow 1"), FResourceStock::Regrow(Remaining, 4, 1), 1);
+	TestEqual(TEXT("Regrow stops at the maximum"), FResourceStock::Regrow(Remaining, 2, 5), 1);
+	TestEqual(TEXT("Full: nothing to add"), FResourceStock::Regrow(Remaining, 2, 1), 0);
+	Remaining = -3;
+	TestEqual(TEXT("Negative stock is repaired, not used"), FResourceStock::Take(Remaining, 1), 0);
+	TestEqual(TEXT("...and reads as empty"), Remaining, 0);
+	return true;
+}
+
+SHAMAN_ECONOMY_TEST(FShamanEconomyGatherRulesTest, "Shaman.Economy.GatherRules")
+bool FShamanEconomyGatherRulesTest::RunTest(const FString& Parameters)
+{
+	const EResourceType All[] = { EResourceType::Wood, EResourceType::Food, EResourceType::Stone, EResourceType::Ore };
+	for (EResourceType R : All)
+	{
+		const FGameplayTag Tag = FGatherRules::TagForResource(R);
+		EResourceType Back = EResourceType::Wood;
+		if (!TestTrue(FString::Printf(TEXT("Task.Gather tag for %s is registered"), FGatherRules::ResourceName(R)), Tag.IsValid())) return false;
+		TestTrue(TEXT("Tag maps back to its resource"), FGatherRules::ResourceOfTag(Tag, Back) && Back == R);
+		TestTrue(TEXT("Gather tags are executable"), FTribeTaskExecutionRules::KindOf(Tag) == ETaskExecKind::Gather);
+	}
+	EResourceType Dummy;
+	TestFalse(TEXT("Task.MoveTo is not a gather tag"), FGatherRules::ResourceOfTag(FGameplayTag::RequestGameplayTag(TEXT("Task.MoveTo"), false), Dummy));
+	TestFalse(TEXT("Invalid tag"), FGatherRules::ResourceOfTag(FGameplayTag(), Dummy));
+
+	FTribeTask Task;
+	Task.Type = FGatherRules::TagForResource(EResourceType::Wood);
+	TestFalse(TEXT("Gather with neither node nor place is invalid"), FTribeTaskExecutionRules::HasValidTarget(Task, ETaskExecKind::Gather));
+	Task.bHasTargetLocation = true;
+	TestTrue(TEXT("Gather with a search origin is valid"), FTribeTaskExecutionRules::HasValidTarget(Task, ETaskExecKind::Gather));
+
+	auto Cand = [](float FromUnit, float FromOrigin, bool bType, bool bDepleted, bool bSlot)
+	{
+		FGatherNodeCandidate C;
+		C.DistanceFromUnit = FromUnit; C.DistanceFromOrigin = FromOrigin; C.bTypeMatches = bType; C.bDepleted = bDepleted; C.bHasFreeSlot = bSlot;
+		return C;
+	};
+	TArray<FGatherNodeCandidate> C;
+	C.Add(Cand(100.f, 100.f, false, false, true));  // 0: wrong kind
+	C.Add(Cand(150.f, 150.f, true, true, true));    // 1: empty
+	C.Add(Cand(200.f, 200.f, true, false, false));  // 2: full
+	C.Add(Cand(900.f, 400.f, true, false, true));   // 3: usable, far from the unit
+	C.Add(Cand(500.f, 5000.f, true, false, true));  // 4: usable, nearer, but outside the search radius
+	C.Add(Cand(700.f, 700.f, true, false, true));   // 5: usable, nearest within the radius
+	TestEqual(TEXT("Nearest usable node within the radius"), FGatherRules::PickNode(C, 3000.f), 5);
+	TestEqual(TEXT("No radius: nearest usable anywhere"), FGatherRules::PickNode(C, 0.f), 4);
+	C.Add(Cand(700.f, 10.f, true, false, true));    // 6: same distance as 5
+	TestEqual(TEXT("Ties go to the lower index"), FGatherRules::PickNode(C, 3000.f), 5);
+	TestEqual(TEXT("Nothing usable"), FGatherRules::PickNode(TArray<FGatherNodeCandidate>{ Cand(1.f, 1.f, true, true, true) }, 3000.f), (int32)INDEX_NONE);
+
+	// Mana: a gathering Brave counts as working (Populous: 34.6 / min), a gathering Warrior would not.
+	TestTrue(TEXT("Gathering Brave makes working mana"),
+		FTribeManaRules::Classify(false, EUnitRole::Brave, EUnitSimState::Gathering, true) == ETribeManaActivity::Working);
+	return true;
+}
+
+SHAMAN_ECONOMY_TEST(FShamanEconomyGatherLoopTest, "Shaman.Economy.GatherLoop")
+bool FShamanEconomyGatherLoopTest::RunTest(const FString& Parameters)
+{
+	FEconomyFixture F(1);
+	if (!TestNotNull(TEXT("Player tribe"), F.T0) || !TestEqual(TEXT("One Brave"), F.Braves.Num(), 1)) return false;
+	TestEqual(TEXT("Tribe starts with an empty stockpile (default config)"), F.T0->GetStockpile().Total(), 0);
+	AResourceNode* Tree = F.SpawnNode(TEXT("Tree"), MakeRow(EResourceType::Wood, 3, 4.f, 2, 0.f, false), FVector(2500.f, 400.f, 0.f));
+	UTribeMemberComponent* M = F.Braves[0]->TribeMember;
+	FUnitTaskExecutor& E = F.Execs[0];
+
+	const int32 Id = F.OrderGather(0, Tree);
+	TestTrue(TEXT("Gather task runs"), F.StateOf(Id) == ETribeTaskState::Active && E.HasControl() && E.GetKind() == ETaskExecKind::Gather);
+	TestTrue(TEXT("Walks to the ordered tree"), E.GetGatherPhase() == EGatherPhase::ToNode && F.Movers[0].LastGoalActor == Tree);
+	TestTrue(TEXT("Counts as gathering"), M->GetSimState() == EUnitSimState::Gathering);
+
+	FEconomyFixture::PutAt(F.Braves[0], Tree->GetActorLocation());
+	F.Step(0.25);
+	TestTrue(TEXT("Arrived: working the tree, holding a slot"), E.GetGatherPhase() == EGatherPhase::Harvesting && Tree->GetGathererCount() == 1);
+	F.Step(2.0);
+	TestTrue(TEXT("Still working after 2 of 4 s"), E.GetGatherPhase() == EGatherPhase::Harvesting && !M->IsCarrying());
+	F.Step(2.1);
+	TestTrue(TEXT("Done: carries 1 wood home"), E.GetGatherPhase() == EGatherPhase::ToDropOff && M->IsCarrying()
+		&& M->GetCarriedType() == EResourceType::Wood && M->GetCarriedAmount() == 1);
+	TestEqual(TEXT("Tree lost a bundle"), Tree->Remaining, 2);
+	TestEqual(TEXT("Slot freed while away"), Tree->GetGathererCount(), 0);
+	TestEqual(TEXT("Nothing delivered yet"), F.Wood(), 0);
+	TestTrue(TEXT("Heads for the drop-off"), F.Movers[0].LastGoal.Equals(F.FireAt, 1.f));
+
+	FEconomyFixture::PutAt(F.Braves[0], F.FireAt);
+	F.Step(0.25);
+	TestEqual(TEXT("Delivered 1 wood"), F.Wood(), 1);
+	TestTrue(TEXT("Hands empty, back to the tree"), !M->IsCarrying() && E.GetGatherPhase() == EGatherPhase::ToNode && E.GetGatherTrips() == 1);
+
+	F.RunTrip(0, Tree);
+	F.RunTrip(0, Tree);
+	TestEqual(TEXT("Three trips: 3 wood"), F.Wood(), 3);
+	TestTrue(TEXT("Tree is empty (kept: it does not get removed)"), Tree->IsDepleted() && !Tree->IsPendingKillPending());
+
+	F.Step(0.25);
+	TestTrue(TEXT("Nothing left nearby: the order completes"), F.StateOf(Id) == ETribeTaskState::Completed && F.ReasonOf(Id).IsNone());
+	TestTrue(TEXT("Brave is free again"), !E.HasControl() && !M->HasTask() && M->IsAvailableWorker());
+	return true;
+}
