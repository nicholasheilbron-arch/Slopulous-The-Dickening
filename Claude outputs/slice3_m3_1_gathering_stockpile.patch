+	PruneGatherers();
+	for (const TWeakObjectPtr<UTribeMemberComponent>& G : Gatherers)
+		if (G.Get() == Member) return true;
+	return Gatherers.Num() < GetMaxGatherers();
+}
+
+bool AResourceNode::ReserveSlot(UTribeMemberComponent* Member)
+{
+	if (!Member || IsDepleted() || IsPendingKillPending() || !HasFreeSlotFor(Member)) return false;
+	for (const TWeakObjectPtr<UTribeMemberComponent>& G : Gatherers)
+		if (G.Get() == Member) return true;
+	Gatherers.Add(Member);
+	return true;
+}
+
+void AResourceNode::ReleaseSlot(const UTribeMemberComponent* Member)
+{
+	Gatherers.RemoveAll([Member](const TWeakObjectPtr<UTribeMemberComponent>& G) { return !G.IsValid() || G.Get() == Member; });
+}
+
+int32 AResourceNode::Harvest(int32 Want)
+{
+	const int32 Taken = FResourceStock::Take(Remaining, Want);
+	if (Taken <= 0) return 0;
+	UpdateVisual();
+	if (IsDepleted() && !CanRegrow() && Row.bDestroyWhenDepleted)
+	{
+		UE_LOG(LogShaman, Log, TEXT("[Economy] %s is used up and removed."), *GetName());
+		Gatherers.Reset();
+		Destroy();
+		return Taken;
+	}
+	UpdateRegrowTimer();
+	return Taken;
+}
+
+int32 AResourceNode::RegrowStep()
+{
+	const int32 Added = FResourceStock::Regrow(Remaining, GetMaxAmount(), Row.RegrowAmount);
+	if (Added > 0) UpdateVisual();
+	UpdateRegrowTimer();
+	return Added;
+}
+
+void AResourceNode::UpdateRegrowTimer()
+{
+	UWorld* W = GetWorld();
+	if (!W) return;
+	FTimerManager& TM = W->GetTimerManager();
+	const bool bWants = CanRegrow() && Remaining < GetMaxAmount() && !IsPendingKillPending();
+	if (bWants && !TM.IsTimerActive(RegrowTimer))
+		TM.SetTimer(RegrowTimer, this, &AResourceNode::RegrowRepeat, Row.RegrowSeconds, true);
+	else if (!bWants && TM.IsTimerActive(RegrowTimer))
+		TM.ClearTimer(RegrowTimer);
+}
+
+void AResourceNode::UpdateVisual()
+{
+	// Shrinks toward 45% of its size as it empties, so a tired forest reads at a glance.
+	const float Max = (float)FMath::Max(1, GetMaxAmount());
+	const float Fill = FMath::Clamp((float)Remaining / Max, 0.f, 1.f);
+	ShamanVisuals::ApplyMesh(Mesh, Row.Mesh, FallbackMesh, Row.MeshScale * FMath::Lerp(0.45f, 1.f, Fill), Row.Tint);
 }
 
