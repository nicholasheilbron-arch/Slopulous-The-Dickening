+	}
+	UE_LOG(LogShaman, Log, TEXT("[Economy] tribe %d spent %s (%s): %s"), TribeId, *Cost.ToString(),
+		Reason.IsNone() ? TEXT("?") : *Reason.ToString(), *Stockpile.ToString());
+	const EResourceType All[] = { EResourceType::Wood, EResourceType::Food, EResourceType::Stone, EResourceType::Ore };
+	for (EResourceType T : All)
+		if (Cost.Get(T) > 0) OnStockpileChanged.Broadcast(TribeId, T, Stockpile.Get(T));
+	return true;
