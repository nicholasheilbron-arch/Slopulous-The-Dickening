+
+bool FUnitTaskExecutor::IsUsableNode(const AResourceNode* Node) const
+{
+	return Node && !Node->IsPendingKillPending() && !Node->IsDepleted() && Node->GetResourceType() == GatherType
+		&& Node->HasFreeSlotFor(Member.Get());
+}
+
+AResourceNode* FUnitTaskExecutor::FindNextNode() const
+{
+	// Runs only when a node runs out or fills up (not per frame): a plain scan of the world's resource nodes.
+	const UTribeMemberComponent* M = Member.Get();
+	UWorld* W = M ? M->GetWorld() : nullptr;
+	if (!W) return nullptr;
+	const FVector Here = M->GetOwner()->GetActorLocation();
+	TArray<AResourceNode*> Nodes;
+	TArray<FGatherNodeCandidate> Candidates;
+	for (TActorIterator<AResourceNode> It(W); It; ++It)
+	{
+		AResourceNode* N = *It;
+		if (!N || N->IsPendingKillPending()) continue;
+		FGatherNodeCandidate C;
+		C.DistanceFromUnit = FShamanSpace::HorizontalDistance(M, Here, N->GetActorLocation());
+		C.DistanceFromOrigin = FShamanSpace::HorizontalDistance(M, GatherOrigin, N->GetActorLocation());
+		C.bTypeMatches = N->GetResourceType() == GatherType;
+		C.bDepleted = N->IsDepleted();
+		C.bHasFreeSlot = N->HasFreeSlotFor(M);
+		Candidates.Add(C);
+		Nodes.Add(N);
+	}
+	const int32 Pick = FGatherRules::PickNode(Candidates, UShamanGameData::Get(M)->Economy.NodeSearchRadius);
+	return Pick == INDEX_NONE ? nullptr : Nodes[Pick];
+}
+
+bool FUnitTaskExecutor::ResolveDropOff(FVector& OutLocation, float& OutAcceptance)
+{
+	const UTribeMemberComponent* M = Member.Get();
+	const UWorld* W = M ? M->GetWorld() : nullptr;
+	const UTribeSubsystem* Tribes = W ? W->GetSubsystem<UTribeSubsystem>() : nullptr;
+	if (!Tribes) return false;
+	const FVector Here = M->GetOwner()->GetActorLocation();
+	const FTribeTaskExecutionConfig& C = Config();
+	ABuildingActor* Best = nullptr;
+	float BestDist = TNumericLimits<float>::Max();
+	for (ABuildingActor* B : Tribes->GetBuildings(M->TribeId))
+	{
+		if (!B || B->IsPendingKillPending() || !B->IsResourceDropOff()) continue;
+		const float D = FShamanSpace::HorizontalDistance(M, Here, B->GetActorLocation());
+		if (D < BestDist) { BestDist = D; Best = B; }
+	}
+	if (Best)
+	{
+		OutLocation = Best->GetActorLocation();
+		OutAcceptance = C.ActorArrivalRadius + FMath::Clamp(Best->GetSimpleCollisionRadius(), 0.f, 2000.f);
+		GatherGoalActor = Best;
+		return true;
+	}
+	// No drop-off building (e.g. the table has no bIsResourceDropOff column yet): the settlement anchor (Campfire, else circle).
+	if (!Tribes->GetSettlementAnchor(M->TribeId, OutLocation)) return false;
+	OutAcceptance = C.ActorArrivalRadius;
+	GatherGoalActor = nullptr;
+	return true;
+}
+
+void FUnitTaskExecutor::ReleaseNodeSlot()
+{
+	if (bHoldingSlot)
+		if (AResourceNode* N = GatherNode.Get()) N->ReleaseSlot(Member.Get());
+	bHoldingSlot = false;
+}
+
+void FUnitTaskExecutor::DepositCarried()
+{
+	UTribeMemberComponent* M = Member.Get();
+	UTribeComponent* Tribe = TaskTribe.Get();
+	if (!M || !Tribe || !M->IsCarrying()) return;
+	const EResourceType Type = M->GetCarriedType();
+	const int32 Amount = M->GetCarriedAmount();
+	M->ClearCarried();
+	Tribe->AddResource(Type, Amount, FName(*GetNameSafe(M->GetOwner())));
+	++GatherTrips;
+}
