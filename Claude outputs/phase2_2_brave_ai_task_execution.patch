+SHAMAN_TASK_TEST(FShamanTaskMoveToActorTest, "Shaman.Tasks.MoveToActor")
+bool FShamanTaskMoveToActorTest::RunTest(const FString& Parameters)
+{
+	using S = ETribeTaskState;
