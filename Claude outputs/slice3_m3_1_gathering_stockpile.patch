+void FUnitTaskExecutor::ContinueGather(double Now)
+{
+	if (GatherDepth >= 3 || !HasControl() || Kind != ETaskExecKind::Gather || !Member.IsValid()) return;
+	++GatherDepth;
+	UpdateGather(Now);
+	--GatherDepth;
+}
+
+void FUnitTaskExecutor::UpdateGather(double Now)
+{
+	UTribeMemberComponent* M = Member.Get();
+	const AActor* Owner = M->GetOwner();
+	const FTribeTaskExecutionConfig& C = Config();
+	M->SetTaskActivity(EUnitSimState::Gathering); // the whole trip is Brave work (mana: working rate)
+
+	// A bundle in hand always goes home before anything else.
+	if (GatherPhase == EGatherPhase::ToNode && M->IsCarrying()) EnterGatherPhase(EGatherPhase::ToDropOff, Now);
+
+	switch (GatherPhase)
+	{
+	case EGatherPhase::ToDropOff:
+	{
+		FVector DropAt;
+		float DropAcceptance = C.ActorArrivalRadius;
+		if (!ResolveDropOff(DropAt, DropAcceptance))
+		{
+			Finish(ETribeTaskState::Failed, TEXT("NoDropOff"), ETaskMoveResult::InvalidTarget);
+			return;
+		}
+		Goal = DropAt;
+		Acceptance = DropAcceptance;
+		const float Dist = FShamanSpace::HorizontalDistance(M, Owner->GetActorLocation(), Goal);
+		const FTaskStepResult S = FTribeTaskExecutionRules::Step(ETaskExecKind::MoveToLocation, Progress, Dist, Acceptance, true, Now, C);
+		if (S.Action == ETaskStepAction::Complete)
+		{
+			Mover->StopTaskMove();
+			DepositCarried();
+			LastResult = ETaskMoveResult::Arrived;
+			EnterGatherPhase(EGatherPhase::ToNode, Now);
+			ContinueGather(Now);
+			return;
+		}
+		if (S.Action == ETaskStepAction::Fail) { Finish(ETribeTaskState::Failed, S.Reason, S.Result); return; }
+		IssueMove(Now);
+		return;
+	}
+	case EGatherPhase::ToNode:
+	{
+		AResourceNode* Node = GatherNode.Get();
+		if (!IsUsableNode(Node))
+		{
+			Node = FindNextNode();
+			const bool bChanged = Node != GatherNode.Get();
+			GatherNode = Node;
+			if (!Node)
+			{
+				UE_LOG(LogShaman, Log, TEXT("[Task] %s task #%d: no %s left within %.0f uu of the order."), *GetNameSafe(Owner), TaskId,
+					FGatherRules::ResourceName(GatherType), UShamanGameData::Get(M)->Economy.NodeSearchRadius);
+				Finish(ETribeTaskState::Completed, TEXT("NothingLeft"), ETaskMoveResult::Arrived);
+				return;
+			}
+			if (bChanged) EnterGatherPhase(EGatherPhase::ToNode, Now);
+		}
+		GatherGoalActor = Node;
+		Goal = Node->GetActorLocation();
+		Acceptance = C.ActorArrivalRadius + FMath::Clamp(Node->GetSimpleCollisionRadius(), 0.f, 2000.f);
+		const float Dist = FShamanSpace::HorizontalDistance(M, Owner->GetActorLocation(), Goal);
+		const FTaskStepResult S = FTribeTaskExecutionRules::Step(ETaskExecKind::MoveToLocation, Progress, Dist, Acceptance, true, Now, C);
+		if (S.Action == ETaskStepAction::Complete)
+		{
+			if (!Node->ReserveSlot(M))
+			{
+				GatherNode = nullptr; // filled up while we walked: pick another next decision
+				return;
+			}
+			bHoldingSlot = true;
+			Mover->StopTaskMove();
+			EnterGatherPhase(EGatherPhase::Harvesting, Now);
+			GatherGoalActor = Node;
+			HarvestEndsAt = Now + Node->GetHarvestSeconds();
+			LastResult = ETaskMoveResult::OnStation;
+			return;
+		}
+		if (S.Action == ETaskStepAction::Fail) { Finish(ETribeTaskState::Failed, S.Reason, S.Result); return; }
+		IssueMove(Now);
+		return;
+	}
+	case EGatherPhase::Harvesting:
+	default:
+	{
+		AResourceNode* Node = GatherNode.Get();
+		if (!Node || Node->IsPendingKillPending() || Node->IsDepleted())
+		{
+			ReleaseNodeSlot();
+			GatherNode = nullptr;
+			EnterGatherPhase(EGatherPhase::ToNode, Now);
+			ContinueGather(Now);
+			return;
+		}
+		Progress.LastProgressTime = Now; // working in place is not being stuck
+		if (Now < HarvestEndsAt) return;
+		ReleaseNodeSlot(); // before Harvest: the last bundle of a stone outcrop removes the node
+		const int32 Got = Node->Harvest(Node->GetBundlesPerTrip());
+		if (Got > 0)
+		{
+			M->SetCarried(GatherType, Got);
+			EnterGatherPhase(EGatherPhase::ToDropOff, Now);
+		}
+		else
+		{
+			GatherNode = nullptr;
+			EnterGatherPhase(EGatherPhase::ToNode, Now);
+		}
+		ContinueGather(Now);
+		return;
+	}
+	}
+}
