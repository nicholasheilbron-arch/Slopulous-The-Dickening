diff --git a/Source/Shaman/Private/Tribes/TribeEconomy.cpp b/Source/Shaman/Private/Tribes/TribeEconomy.cpp
new file mode 100644
index 0000000..5071ded
--- /dev/null
+++ b/Source/Shaman/Private/Tribes/TribeEconomy.cpp
@@ -0,0 +1,172 @@
+#include "Tribes/TribeEconomy.h"
+
+namespace
+{
+	int32 TribeEconomyAtLeastZero(int32 V) { return V > 0 ? V : 0; }
+}
+
+// ---- FResourceCost ---------------------------------------------------------------------------------------------------
+
+int32 FResourceCost::Get(EResourceType Type) const
+{
+	switch (Type)
+	{
+	case EResourceType::Wood:  return TribeEconomyAtLeastZero(Wood);
+	case EResourceType::Food:  return TribeEconomyAtLeastZero(Food);
+	case EResourceType::Stone: return TribeEconomyAtLeastZero(Stone);
+	case EResourceType::Ore:   return TribeEconomyAtLeastZero(Ore);
+	default:                   return 0;
+	}
+}
+
+bool FResourceCost::IsFree() const
+{
+	return Get(EResourceType::Wood) == 0 && Get(EResourceType::Food) == 0 && Get(EResourceType::Stone) == 0 && Get(EResourceType::Ore) == 0;
+}
+
+FString FResourceCost::ToString() const
+{
+	FString Out;
+	const EResourceType Order[] = { EResourceType::Wood, EResourceType::Stone, EResourceType::Ore, EResourceType::Food };
+	for (EResourceType T : Order)
+	{
+		const int32 N = Get(T);
+		if (N <= 0) continue;
+		if (!Out.IsEmpty()) Out += TEXT(", ");
+		Out += FString::Printf(TEXT("%d %s"), N, FGatherRules::ResourceName(T));
+	}
+	return Out.IsEmpty() ? FString(TEXT("free")) : Out;
+}
+
+// ---- FTribeStockpile -------------------------------------------------------------------------------------------------
+
+int32* FTribeStockpile::Find(EResourceType Type)
+{
+	switch (Type)
+	{
+	case EResourceType::Wood:  return &Wood;
+	case EResourceType::Food:  return &Food;
+	case EResourceType::Stone: return &Stone;
+	case EResourceType::Ore:   return &Ore;
+	default:                   return nullptr;
+	}
+}
+
+int32 FTribeStockpile::Get(EResourceType Type) const
+{
+	switch (Type)
+	{
+	case EResourceType::Wood:  return TribeEconomyAtLeastZero(Wood);
+	case EResourceType::Food:  return TribeEconomyAtLeastZero(Food);
+	case EResourceType::Stone: return TribeEconomyAtLeastZero(Stone);
+	case EResourceType::Ore:   return TribeEconomyAtLeastZero(Ore);
+	default:                   return 0;
+	}
+}
+
+int32 FTribeStockpile::Add(EResourceType Type, int32 Amount)
+{
+	int32* Slot = Find(Type);
+	if (!Slot || Amount <= 0) return 0;
+	const int32 Room = MAX_int32 - TribeEconomyAtLeastZero(*Slot);
+	const int32 Added = FMath::Min(Amount, Room);
+	*Slot = TribeEconomyAtLeastZero(*Slot) + Added;
+	return Added;
+}
+
+bool FTribeStockpile::CanAfford(const FResourceCost& Cost) const
+{
+	return Get(EResourceType::Wood) >= Cost.Get(EResourceType::Wood) && Get(EResourceType::Food) >= Cost.Get(EResourceType::Food)
+		&& Get(EResourceType::Stone) >= Cost.Get(EResourceType::Stone) && Get(EResourceType::Ore) >= Cost.Get(EResourceType::Ore);
+}
+
+bool FTribeStockpile::Spend(const FResourceCost& Cost)
+{
+	if (!CanAfford(Cost)) return false;
+	Wood = Get(EResourceType::Wood) - Cost.Get(EResourceType::Wood);
+	Food = Get(EResourceType::Food) - Cost.Get(EResourceType::Food);
+	Stone = Get(EResourceType::Stone) - Cost.Get(EResourceType::Stone);
+	Ore = Get(EResourceType::Ore) - Cost.Get(EResourceType::Ore);
+	return true;
+}
+
+FString FTribeStockpile::ToString() const
+{
+	return FString::Printf(TEXT("Wood %d  Stone %d  Ore %d  Food %d"), Get(EResourceType::Wood), Get(EResourceType::Stone),
+		Get(EResourceType::Ore), Get(EResourceType::Food));
+}
+
+// ---- FResourceStock --------------------------------------------------------------------------------------------------
+
+int32 FResourceStock::Take(int32& Remaining, int32 Want)
+{
+	if (Want <= 0 || Remaining <= 0) { Remaining = TribeEconomyAtLeastZero(Remaining); return 0; }
+	const int32 Taken = FMath::Min(Want, Remaining);
+	Remaining -= Taken;
+	return Taken;
+}
+
+int32 FResourceStock::Regrow(int32& Remaining, int32 Max, int32 Amount)
+{
+	Remaining = TribeEconomyAtLeastZero(Remaining);
+	if (Amount <= 0 || Remaining >= Max) return 0;
+	const int32 Added = FMath::Min(Amount, Max - Remaining);
+	Remaining += Added;
+	return Added;
+}
+
+// ---- FGatherRules ----------------------------------------------------------------------------------------------------
+
+bool FGatherRules::ResourceOfTag(const FGameplayTag& Tag, EResourceType& OutType)
+{
+	if (!Tag.IsValid()) return false;
+	const EResourceType All[] = { EResourceType::Wood, EResourceType::Food, EResourceType::Stone, EResourceType::Ore };
+	for (EResourceType T : All)
+	{
+		const FGameplayTag G = TagForResource(T);
+		if (G.IsValid() && Tag == G) { OutType = T; return true; }
+	}
+	return false;
+}
+
+FGameplayTag FGatherRules::TagForResource(EResourceType Type)
+{
+	static const FGameplayTag Wood = FGameplayTag::RequestGameplayTag(TEXT("Task.Gather.Wood"), false);
+	static const FGameplayTag Food = FGameplayTag::RequestGameplayTag(TEXT("Task.Gather.Food"), false);
+	static const FGameplayTag Stone = FGameplayTag::RequestGameplayTag(TEXT("Task.Gather.Stone"), false);
+	static const FGameplayTag Ore = FGameplayTag::RequestGameplayTag(TEXT("Task.Gather.Ore"), false);
+	switch (Type)
+	{
+	case EResourceType::Wood:  return Wood;
+	case EResourceType::Food:  return Food;
+	case EResourceType::Stone: return Stone;
+	case EResourceType::Ore:   return Ore;
+	default:                   return FGameplayTag();
+	}
+}
+
+int32 FGatherRules::PickNode(const TArray<FGatherNodeCandidate>& Candidates, float MaxDistanceFromOrigin)
+{
+	int32 Best = INDEX_NONE;
+	float BestDistance = TNumericLimits<float>::Max();
+	for (int32 i = 0; i < Candidates.Num(); ++i)
+	{
+		const FGatherNodeCandidate& C = Candidates[i];
+		if (!C.bTypeMatches || C.bDepleted || !C.bHasFreeSlot) continue;
+		if (MaxDistanceFromOrigin > 0.f && C.DistanceFromOrigin > MaxDistanceFromOrigin) continue;
+		if (C.DistanceFromUnit < BestDistance) { BestDistance = C.DistanceFromUnit; Best = i; }
+	}
+	return Best;
+}
+
+const TCHAR* FGatherRules::ResourceName(EResourceType Type)
+{
+	switch (Type)
+	{
+	case EResourceType::Wood:  return TEXT("wood");
+	case EResourceType::Food:  return TEXT("food");
+	case EResourceType::Stone: return TEXT("stone");
+	case EResourceType::Ore:   return TEXT("ore");
+	default:                   return TEXT("?");
+	}
+}
