@@ -0,0 +1,404 @@
+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+#include "GameplayTagContainer.h"
+#include "TribeComponent.h"
+#include "TribeMemberComponent.h"
+#include "Tribes/TribeEconomy.h"
+#include "Tribes/TribeMana.h"
+#include "Tribes/TribeTaskTypes.h"
+#include "Tribes/TribeTaskExecution.h"
+#include "Characters/ShamanUnitBase.h"
+#include "Characters/ShamanCharacter.h"
+#include "Characters/HealthComponent.h"
+#include "World/ResourceNode.h"
+#include "World/ResourceRow.h"
+#include "Buildings/BuildingRow.h"
+#include "Engine/DataTable.h"
+#include "ShamanTribeTestWorld.h"
+
+/**
+ * Slice 3 milestone 3.1: resources, gathering and the tribe stockpile.
+ *  - Stockpile / ResourceStock / GatherRules: the pure rules (no world).
+ *  - GatherLoop / NextNode / CarrierDeath / CarryHomeFirst / NodeDepletion: FUnitTaskExecutor's gather loop on real
+ *    tribes and production unit rows, with resource nodes given a fixed test row (ApplyRow) so they do not depend on
+ *    DT_Resources. Movement goes through a recording fake movement layer; arrival is produced by teleporting the unit
+ *    and time is passed explicitly. Real UE4 path following is NOT exercised here (in-editor check).
+ *  - ProductionData: DT_Resources / DT_Buildings carry the 3.1 columns. Fails until Resources.csv and Buildings.csv
+ *    are reimported in the editor.
+ * Flat test world throughout.
+ */
+namespace ShamanEconomyTestsPrivate
+{
+	using namespace ShamanTribeTestsPrivate;
+
+	struct FRecordingMover : public IUnitTaskMover
+	{
+		int32 Requests = 0;
+		int32 Stops = 0;
+		FVector LastGoal = FVector::ZeroVector;
+		AActor* LastGoalActor = nullptr;
+		virtual ETaskMoveRequest RequestTaskMove(const FVector& Goal, AActor* GoalActor, float) override { ++Requests; LastGoal = Goal; LastGoalActor = GoalActor; return ETaskMoveRequest::Accepted; }
+		virtual void StopTaskMove() override { ++Stops; }
+		virtual bool IsTaskMoveInProgress() const override { return true; }
+	};
+
+	FResourceRow MakeRow(EResourceType Type, int32 Amount, float HarvestSeconds, int32 MaxGatherers, float RegrowSeconds, bool bDestroyWhenDepleted)
+	{
+		FResourceRow R;
+		R.DisplayName = FText::FromString(TEXT("Test node"));
+		R.Type = Type;
+		R.Amount = Amount;
+		R.BundlesPerTrip = 1;
+		R.HarvestSeconds = HarvestSeconds;
+		R.MaxGatherers = MaxGatherers;
+		R.RegrowSeconds = RegrowSeconds;
+		R.RegrowAmount = 1;
+		R.bDestroyWhenDepleted = bDestroyWhenDepleted;
+		return R;
+	}
+
+	/** Player Shaman, a Campfire (the drop-off) at FireAt and NumBraves Braves (max 2), each with its own executor. */
+	struct FEconomyFixture
+	{
+		FTribeTestWorld W;
+		AShamanCharacter* Shaman = nullptr;
+		ABuildingActor* Fire = nullptr;
+		UTribeComponent* T0 = nullptr;
+		TArray<AShamanUnitBase*> Braves;
+		const FVector FireAt = FVector(0.f, -1000.f, 0.f);
+		double T = 0.0;
+		FRecordingMover Movers[2];
+		FUnitTaskExecutor Execs[2]; // declared after W: unbind before the world goes away
+
+		explicit FEconomyFixture(int32 NumBraves)
+		{
+			Shaman = W.SpawnUnit<AShamanCharacter>(W.Data->ShamanUnitId, 0, FVector(0.f, 0.f, 100.f));
+			Fire = W.SpawnBuilding(W.Data->CampfireBuildingId, 0, FireAt);
+			for (int32 i = 0; i < FMath::Min(NumBraves, 2); ++i)
+			{
+				Braves.Add(W.SpawnUnit<AShamanUnitBase>(W.Data->BraveUnitId, 0, FVector(300.f * (i + 1), 400.f, 100.f)));
+				Execs[i].Bind(Braves[i]->TribeMember, &Movers[i]);
+			}
+			T0 = W.Tribes->GetTribeComponent(0);
+			T = W.World->GetTimeSeconds();
+		}
+		AResourceNode* SpawnNode(FName Id, const FResourceRow& Row, const FVector& Where)
+		{
+			AResourceNode* N = W.World->SpawnActorDeferred<AResourceNode>(AResourceNode::StaticClass(), FTransform(Where), nullptr, nullptr,
+				ESpawnActorCollisionHandlingMethod::AlwaysSpawn);
+			N->ResourceId = Id;
+			N->FinishSpawning(FTransform(Where));
+			if (!N->HasActorBegunPlay()) N->DispatchBeginPlay();
+			N->ApplyRow(Row, true);
+			return N;
+		}
+		int32 OrderGather(int32 BraveIndex, AResourceNode* Node)
+		{
+			UTribeMemberComponent* M = Braves[BraveIndex]->TribeMember;
+			if (M->HasTask()) T0->CancelTask(M->GetCurrentTaskId(), TEXT("Test"));
+			const int32 Id = T0->CreateTask(FGatherRules::TagForResource(Node->GetResourceType()), ETribeTaskPriority::High, Node,
+				Node->GetActorLocation(), true, TEXT("Test"));
+			T0->AssignTask(Id, M);
+			T0->StartTask(Id);
+			return Id;
+		}
+		void Step(double Seconds)
+		{
+			T += Seconds;
+			for (int32 i = 0; i < Braves.Num(); ++i) Execs[i].Update(T);
+		}
+		/** Puts a Brave right beside a spot (well inside every arrival radius). */
+		static void PutAt(AActor* A, const FVector& Where) { A->SetActorLocation(Where + FVector(40.f, 0.f, 100.f), false, nullptr, ETeleportType::TeleportPhysics); }
+		ETribeTaskState StateOf(int32 Id) const { const FTribeTask* Task = T0->FindTask(Id); return Task ? Task->State : ETribeTaskState::Unassigned; }
+		FName ReasonOf(int32 Id) const { const FTribeTask* Task = T0->FindTask(Id); return Task ? Task->EndReason : NAME_None; }
+		int32 Wood() const { return T0->GetResourceAmount(EResourceType::Wood); }
+
+		/** One whole trip for Braves[i] standing anywhere: walk to Node, harvest, carry home, deposit. */
+		void RunTrip(int32 i, AResourceNode* Node)
+		{
+			PutAt(Braves[i], Node->GetActorLocation());
+			Step(0.25);                                           // arrives, takes a slot, starts working
+			Step(FMath::Max(0.25, (double)Node->GetHarvestSeconds() + 0.05)); // work done: carrying
+			PutAt(Braves[i], FireAt);
+			Step(0.25);                                           // delivers
+		}
+	};
+}
