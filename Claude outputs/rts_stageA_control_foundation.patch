+// ---- RTS controls overlay ----------------------------------------------------------------------------------------------
+
+void AShamanHUD::DrawSelectionRing(const AShamanUnitBase* Unit, float RadiusScale, const FLinearColor& Color)
+{
+	if (!Unit || !PlayerOwner) return;
+	const FVector L = Unit->GetActorLocation();
+	const FVector Up = FShamanSpace::GetUp(this, L);
+	FPlanetFrame Planet;
+	if (PlayerOwner->PlayerCameraManager && FShamanSpace::GetPlanet(this, Planet)
+		&& FVector::DotProduct(Up, PlayerOwner->PlayerCameraManager->GetCameraLocation() - L) < 0.f) return; // far side of the planet
+	const UCapsuleComponent* Cap = Unit->GetCapsuleComponent();
+	const float Half = Cap ? Cap->GetScaledCapsuleHalfHeight() : 90.f;
+	const float R = (Cap ? Cap->GetScaledCapsuleRadius() : 40.f) * RadiusScale;
+	const FVector Centre = L - Up * (Half - 4.f);
+	const FVector Hint = FMath::Abs(Up.Z) < 0.9f ? FVector::UpVector : FVector::ForwardVector;
+	const FVector X = (Hint - Up * FVector::DotProduct(Hint, Up)).GetSafeNormal();
+	const FVector Y = FVector::CrossProduct(Up, X);
+
+	const int32 N = 24;
+	FVector2D Prev;
+	bool bPrev = false;
+	for (int32 i = 0; i <= N; ++i)
+	{
+		const float A = 2.f * PI * i / N;
+		FVector2D P;
+		const bool bOk = PlayerOwner->ProjectWorldLocationToScreen(Centre + (X * FMath::Cos(A) + Y * FMath::Sin(A)) * R, P, false);
+		if (bOk && bPrev)
+		{
+			AHUD::DrawLine(Prev.X, Prev.Y, P.X, P.Y, FLinearColor(0.f, 0.f, 0.f, 0.6f), 5.f); // dark outline: readable on any ground
+			AHUD::DrawLine(Prev.X, Prev.Y, P.X, P.Y, Color, 2.5f);
+		}
+		Prev = P;
+		bPrev = bOk;
+	}
+	// Chevron above the head: still visible when the feet are hidden behind terrain.
+	FVector2D H;
+	if (PlayerOwner->ProjectWorldLocationToScreen(L + Up * (Half + 45.f), H, false))
+	{
+		AHUD::DrawLine(H.X - 7.f, H.Y - 7.f, H.X, H.Y, Color, 2.5f);
+		AHUD::DrawLine(H.X + 7.f, H.Y - 7.f, H.X, H.Y, Color, 2.5f);
+	}
+}
+
+void AShamanHUD::DrawControlOverlay(const AShamanPlayerController* PC, float SW, float SH, float UI)
+{
+	const bool bRTS = PC->GetControlMode() == EShamanControlMode::RTS;
+	const FShamanSelectionSettings& Sel = PC->SelectionSettings;
+
+	// Mode banner (top centre).
+	DrawLine(bRTS ? TEXT("RTS MODE") : TEXT("SHAMAN MODE"), SW * 0.5f, 10.f * UI,
+		bRTS ? FLinearColor(1.f, 0.85f, 0.25f) : FLinearColor(0.55f, 0.85f, 1.f), 1.4f * UI, true);
+	DrawLine(bRTS
+		? TEXT("Enter: Shaman mode   LMB: select / drag box (Shift adds)   WASD: pan   Q/E or MMB drag: rotate   Wheel: zoom   F: focus   Home: Shaman   Backspace: clear")
+		: TEXT("Enter: RTS mode"), SW * 0.5f, 40.f * UI, FLinearColor(1.f, 1.f, 1.f, 0.65f), 0.7f * UI, true);
+
+	// Selection rings (shown in both modes; selection is kept across switches).
+	if (const UShamanSelectionComponent* Selection = PC->Selection)
+	{
+		const TArray<AShamanUnitBase*> Units = Selection->GetSelectedUnits();
+		for (const AShamanUnitBase* U : Units) DrawSelectionRing(U, Sel.RingRadiusScale, Sel.RingColor);
+		if (bRTS && Units.Num() > 0)
+			DrawLine(FString::Printf(TEXT("Selected: %d"), Units.Num()), SW * 0.5f, 62.f * UI, Sel.RingColor, 0.85f * UI, true);
+	}
+
+	// Drag box: translucent fill with a glowing edge.
+	if (bRTS && PC->IsDragSelecting())
+	{
+		FVector2D A, B;
+		PC->GetDragRect(A, B);
+		const float X0 = FMath::Min(A.X, B.X), Y0 = FMath::Min(A.Y, B.Y), X1 = FMath::Max(A.X, B.X), Y1 = FMath::Max(A.Y, B.Y);
+		DrawRect(Sel.BoxFillColor, X0, Y0, X1 - X0, Y1 - Y0);
+		const FLinearColor Glow(Sel.BoxEdgeColor.R, Sel.BoxEdgeColor.G, Sel.BoxEdgeColor.B, 0.3f);
+		for (int32 Pass = 0; Pass < 2; ++Pass)
+		{
+			const FLinearColor C = Pass == 0 ? Glow : Sel.BoxEdgeColor;
+			const float T = Pass == 0 ? 6.f : 2.f;
+			AHUD::DrawLine(X0, Y0, X1, Y0, C, T); AHUD::DrawLine(X1, Y0, X1, Y1, C, T);
+			AHUD::DrawLine(X1, Y1, X0, Y1, C, T); AHUD::DrawLine(X0, Y1, X0, Y0, C, T);
+		}
+	}
+}
diff --git a/Source/Shaman/Public/Player/ShamanControlTypes.h b/Source/Shaman/Public/Player/ShamanControlTypes.h
new file mode 100644
index 0000000..ac9b1c5
--- /dev/null
+++ b/Source/Shaman/Public/Player/ShamanControlTypes.h
@@ -0,0 +1,111 @@
+#pragma once
+#include "CoreMinimal.h"
+#include "ShamanControlTypes.generated.h"
+
+class AShamanUnitBase;
+struct FPlanetFrame;
+
+/**
+ * Hybrid RTS controls (RTS milestone, Stage A): shared types and the pure math behind the strategic camera and unit
+ * selection. Nothing here touches the world, so camera and selection rules are unit-tested on their own.
+ */
+
+/** Who the player is driving: the tribe from the strategic camera, or the Shaman directly (Phase 1 controls). */
+UENUM(BlueprintType)
+enum class EShamanControlMode : uint8
+{
+	RTS,
+	Shaman
+};
+
+/** Strategic camera tuning (AShamanPlayerController::CameraSettings). Distances in uu, angles in degrees. */
+USTRUCT(BlueprintType)
+struct SHAMAN_API FShamanRTSCameraSettings
+{
+	GENERATED_BODY()
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="100")) float InitialDistance = 4200.f;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="100")) float MinDistance = 700.f;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="100")) float MaxDistance = 14000.f;
+	/** Angle of the view below the local horizon. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="5", ClampMax="89")) float InitialPitch = 55.f;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="5", ClampMax="89")) float MinPitch = 25.f;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="5", ClampMax="89")) float MaxPitch = 85.f;
+	/** Pan speed as a fraction of the current zoom distance per second (zoomed out pans faster). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="0")) float PanSpeed = 1.1f;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="0")) float RotateSpeed = 90.f;
+	/** Middle-mouse drag orbit, degrees per pixel. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="0")) float MouseOrbitSpeed = 0.25f;
+	/** Fraction of the distance removed per mouse-wheel step. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="0.01", ClampMax="0.5")) float ZoomStep = 0.12f;
+	/** The camera is lifted to stay at least this far above the ground under it (hills, cliffs). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="0")) float MinHeightAboveGround = 250.f;
+	/** Pan when the mouse is at the screen edge. Off by default (annoying in a windowed editor viewport). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera") bool bEdgePan = false;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="1")) float EdgePanMarginPx = 8.f;
+	/** Camera blend when switching modes (0 = cut). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Camera", meta=(ClampMin="0")) float ModeBlendTime = 0.25f;
+};
+
+/** Selection tuning (AShamanPlayerController::SelectionSettings). */
+USTRUCT(BlueprintType)
+struct SHAMAN_API FShamanSelectionSettings
+{
+	GENERATED_BODY()
+	/** A left press that moves further than this becomes a drag-box selection instead of a click. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Selection", meta=(ClampMin="1")) float DragThresholdPx = 6.f;
+	/** Click tolerance around a unit's on-screen body. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Selection", meta=(ClampMin="1")) float PickRadiusPx = 16.f;
+	/** Selection ring radius as a multiple of the unit's capsule radius. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Selection", meta=(ClampMin="0.5")) float RingRadiusScale = 1.8f;
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Selection") FLinearColor RingColor = FLinearColor(1.f, 0.85f, 0.1f, 1.f);
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Selection") FLinearColor BoxFillColor = FLinearColor(0.35f, 0.85f, 1.f, 0.18f);
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category="Selection") FLinearColor BoxEdgeColor = FLinearColor(0.55f, 0.95f, 1.f, 1.f);
+};
+
+/**
+ * The strategic camera as a pure value: a ground focus point, a heading tangent to the ground there, a pitch below the
+ * local horizon and a distance. "Up" is the planet's radial up when a planet frame is given, world +Z otherwise.
+ * The heading is parallel-transported as the focus moves, so the view never flips when crossing curved terrain.
+ */
+struct SHAMAN_API FShamanRTSCameraRig
+{
+	FVector Focus = FVector::ZeroVector;
+	FVector Forward = FVector(1.f, 0.f, 0.f);
+	float PitchDeg = 55.f;
+	float Distance = 4200.f;
+
+	static FVector UpAt(const FPlanetFrame* Planet, const FVector& Location);
+	/** Re-projects Forward onto the tangent plane at Focus (keeps it unit and horizontal). */
+	void Normalize(const FPlanetFrame* Planet);
+	/** Moves the focus along the ground by DForward / DRight uu (planet: along the sphere at the same radius). */
+	void Pan(const FPlanetFrame* Planet, float DForward, float DRight);
+	/** Turns the heading about the local up and tilts the pitch (clamped). */
+	void Orbit(const FPlanetFrame* Planet, float YawDeg, float PitchDeltaDeg, const FShamanRTSCameraSettings& Settings);
+	/** Steps > 0 zooms in, < 0 zooms out; distance clamped to [MinDistance, MaxDistance]. */
+	void Zoom(float Steps, const FShamanRTSCameraSettings& Settings);
+	/** World camera location and rotation for the current state. */
+	void GetView(const FPlanetFrame* Planet, FVector& OutLocation, FRotator& OutRotation) const;
+	FVector GetRight(const FPlanetFrame* Planet) const;
+};
+
+/** A unit as seen on screen, for click and box picking. Feet/Head are viewport pixel positions. */
+struct SHAMAN_API FShamanScreenCandidate
+{
+	TWeakObjectPtr<AShamanUnitBase> Unit;
+	FVector2D Feet = FVector2D::ZeroVector;
+	FVector2D Head = FVector2D::ZeroVector;
+	bool bOnScreen = false;
+};
+
+/** Selection rules (pure). */
+struct SHAMAN_API FShamanSelectionRules
+{
+	/** A living Brave/follower or the Shaman of the player's tribe. Never enemies, Wildmen, buildings or corpses. */
+	static bool IsSelectable(const AShamanUnitBase* Unit, int32 PlayerTribe);
+	static bool IsDrag(const FVector2D& Start, const FVector2D& Current, float ThresholdPx);
+	/** Index of the candidate whose body (feet-head segment) is nearest the mouse within RadiusPx, or INDEX_NONE. */
+	static int32 PickClosest(const TArray<FShamanScreenCandidate>& Candidates, const FVector2D& Mouse, float RadiusPx);
+	/** Candidates whose body centre lies in the rectangle spanned by A and B (any corner order). */
+	static void BoxSelect(const TArray<FShamanScreenCandidate>& Candidates, const FVector2D& A, const FVector2D& B, TArray<int32>& OutIndices);
+	static float DistanceToSegment(const FVector2D& P, const FVector2D& A, const FVector2D& B);
+};
diff --git a/Source/Shaman/Public/Player/ShamanPlayerController.h b/Source/Shaman/Public/Player/ShamanPlayerController.h
new file mode 100644
index 0000000..a5e93ae
--- /dev/null
+++ b/Source/Shaman/Public/Player/ShamanPlayerController.h
@@ -0,0 +1,105 @@
+#pragma once
+#include "CoreMinimal.h"
+#include "GameFramework/PlayerController.h"
+#include "Player/ShamanControlTypes.h"
+#include "ShamanPlayerController.generated.h"
+
+class AShamanRTSCamera;
+class AShamanUnitBase;
+class UShamanSelectionComponent;
+class UInputComponent;
+
+/**
+ * Hybrid controls (RTS milestone, Stage A). The controller always possesses the player Shaman (so reincarnation,
+ * spells, HUD and every system that asks "who is the player's pawn" are unchanged); the control mode only decides
+ * the view target and which input layer is active:
+ *   - RTS (default at start): view through AShamanRTSCamera; an RTS input layer (pushed, bBlockInput) takes all keys,
+ *     so the Shaman's own bindings (WASD, mouse look, cast, melee, interact) never fire. Mouse cursor shown.
+ *   - Shaman: the RTS layer is popped; the Shaman's Phase 1 bindings work exactly as before.
+ * Enter toggles (bound on the RTS layer and on the controller's own layer; only one is ever active, so one press
+ * toggles once). Keys held during a switch are flushed so nothing carries over.
+ *
+ * RTS keys: LMB click select / drag box (Shift adds), WASD or arrows pan, Q/E rotate, middle-mouse drag orbit,
+ * wheel zoom, F focus selection (or Shaman), Home focus Shaman, Backspace or Esc clear selection (Esc stops Play-in-Editor
+ * before the game sees it, so use Backspace there), F3 debug.
+ */
+UCLASS()
+class SHAMAN_API AShamanPlayerController : public APlayerController
+{
+	GENERATED_BODY()
+public:
+	AShamanPlayerController();
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Controls") EShamanControlMode StartMode = EShamanControlMode::RTS;
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Controls") FShamanRTSCameraSettings CameraSettings;
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Controls") FShamanSelectionSettings SelectionSettings;
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Controls") TSubclassOf<AShamanRTSCamera> RTSCameraClass;
+	UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Controls") UShamanSelectionComponent* Selection;
+
+	UFUNCTION(BlueprintCallable, Category="Controls") EShamanControlMode GetControlMode() const { return Mode; }
+	UFUNCTION(BlueprintCallable, Category="Controls") void SetControlMode(EShamanControlMode NewMode);
+	UFUNCTION(BlueprintCallable, Category="Controls") void ToggleControlMode();
+	/** Console: ShamanControlMode (toggle). */
+	UFUNCTION(Exec) void ShamanControlMode();
+
+	AShamanRTSCamera* GetRTSCamera() const { return RTSCamera; }
+	int32 GetPlayerTribe() const;
+
+	// Camera actions (also used by tests).
+	void PanCamera(float ForwardAxis, float RightAxis, float DeltaSeconds);
+	void OrbitCamera(float YawDeg, float PitchDeltaDeg);
+	void ZoomCamera(float Steps);
+	void FocusCameraOnShaman();
+	void FocusCameraOnSelection();
+
+	// Selection gesture (screen pixels; also used by tests).
+	void BeginSelectGesture(const FVector2D& ScreenPos);
+	void UpdateSelectGesture(const FVector2D& ScreenPos);
+	void EndSelectGesture(const FVector2D& ScreenPos, bool bAdditive);
+	void CancelSelectGesture();
+	bool IsDragSelecting() const { return bSelectPressed && bDragging; }
+	void GetDragRect(FVector2D& OutA, FVector2D& OutB) const { OutA = DragStart; OutB = DragCurrent; }
+	/** The player's selectable units projected to the screen (player tribe roster + Shaman; no world scan). */
+	void GatherScreenCandidates(TArray<FShamanScreenCandidate>& Out) const;
+
+protected:
+	virtual void SetupInputComponent() override;
+	virtual void OnPossess(APawn* InPawn) override;
+	virtual void PlayerTick(float DeltaTime) override;
+	virtual void EndPlay(const EEndPlayReason::Type Reason) override;
+
+	/** bFromPossess: re-applied right after (re)possession - instant, no key flush, camera kept where it is. */
+	void ApplyControlMode(bool bFirstTime, bool bFromPossess = false);
+	/** Returns true when a new camera was spawned (it then needs PlaceCameraAtStart). */
+	bool EnsureRTSCamera();
+	/** Planets: false for points on the far side of the globe from the camera (not visible, not pickable). */
+	bool IsOnVisibleSide(const FVector& WorldLocation) const;
+	void PlaceCameraAtStart();
+	void UpdateRTSInput(float DeltaTime);
+
+	// Input handlers
+	void OnToggleModePressed();
+	void OnSelectPressed();
+	void OnSelectReleased();
+	void OnOrbitPressed();
+	void OnOrbitReleased();
+	void OnZoomIn();
+	void OnZoomOut();
+	void OnFocusSelection();
+	void OnFocusShaman();
+	void OnClearSelection();
+	void OnToggleDebug();
+
+	UPROPERTY(Transient) UInputComponent* RTSInput = nullptr;
+	UPROPERTY(Transient) AShamanRTSCamera* RTSCamera = nullptr;
+
+	EShamanControlMode Mode = EShamanControlMode::RTS;
+	bool bModeInitialized = false;
+	bool bRTSInputPushed = false;
+	bool bSelectPressed = false;
+	bool bDragging = false;
+	bool bOrbiting = false;
+	FVector2D DragStart = FVector2D::ZeroVector;
+	FVector2D DragCurrent = FVector2D::ZeroVector;
+	FVector2D LastMouse = FVector2D::ZeroVector;
+};
diff --git a/Source/Shaman/Public/Player/ShamanRTSCamera.h b/Source/Shaman/Public/Player/ShamanRTSCamera.h
new file mode 100644
index 0000000..fe847df
--- /dev/null
+++ b/Source/Shaman/Public/Player/ShamanRTSCamera.h
@@ -0,0 +1,42 @@
+#pragma once
+#include "CoreMinimal.h"
+#include "GameFramework/Actor.h"
+#include "Player/ShamanControlTypes.h"
+#include "ShamanRTSCamera.generated.h"
+
+class UCameraComponent;
+
+/**
+ * Strategic (RTS) camera: an actor the player controller uses as its view target in RTS mode. It is not a pawn, so
+ * moving it never moves the Shaman. State lives in FShamanRTSCameraRig (pure math); this actor applies it each frame,
+ * keeps the focus on the ground (FShamanSpace::ProjectToGround) and lifts the camera clear of hills.
+ */
+UCLASS()
+class SHAMAN_API AShamanRTSCamera : public AActor
+{
+	GENERATED_BODY()
+public:
+	AShamanRTSCamera();
+
+	UPROPERTY(VisibleAnywhere, BlueprintReadOnly) UCameraComponent* Camera;
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Camera") FShamanRTSCameraSettings Settings;
+
+	/** Puts the focus on the ground at Anchor, heading along ForwardHint, at the initial pitch and distance. */
+	void InitializeView(const FVector& Anchor, const FVector& ForwardHint);
+	/** Axis values in [-1, 1]; scaled by PanSpeed * Distance * DeltaSeconds. */
+	void Pan(float ForwardAxis, float RightAxis, float DeltaSeconds);
+	void Orbit(float YawDeg, float PitchDeltaDeg);
+	void Zoom(float Steps);
+	/** Moves the focus (keeps heading, pitch and zoom). */
+	void FocusOn(const FVector& Location);
+	/** Recomputes and applies the camera transform now (also done every tick). */
+	void UpdateView();
+
+	const FShamanRTSCameraRig& GetRig() const { return Rig; }
+
+	virtual void Tick(float DeltaSeconds) override;
+
+protected:
+	void SnapFocusToGround();
+	FShamanRTSCameraRig Rig;
+};
