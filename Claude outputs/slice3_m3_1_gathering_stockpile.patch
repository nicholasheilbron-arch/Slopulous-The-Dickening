+	const FResourceRow* Tree = W.Data->ResourceTable->FindRow<FResourceRow>(W.Data->TreeResourceId, TEXT("Test"), false);
+	const FResourceRow* Stone = W.Data->ResourceTable->FindRow<FResourceRow>(W.Data->StoneResourceId, TEXT("Test"), false);
+	const FBuildingRow* Fire = W.Data->BuildingTable->FindRow<FBuildingRow>(W.Data->CampfireBuildingId, TEXT("Test"), false);
+	if (!TestNotNull(TEXT("Tree row"), Tree) || !TestNotNull(TEXT("Stone row"), Stone) || !TestNotNull(TEXT("Campfire row"), Fire)) return false;
