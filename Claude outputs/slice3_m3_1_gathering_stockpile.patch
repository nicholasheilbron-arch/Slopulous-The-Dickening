+SHAMAN_ECONOMY_TEST(FShamanEconomyCarryHomeFirstTest, "Shaman.Economy.CarryHomeFirst")
+bool FShamanEconomyCarryHomeFirstTest::RunTest(const FString& Parameters)
+{
+	FEconomyFixture F(1);
+	AResourceNode* Tree = F.SpawnNode(TEXT("Tree"), MakeRow(EResourceType::Wood, 4, 1.f, 2, 0.f, false), FVector(2500.f, 400.f, 0.f));
+	AResourceNode* Rock = F.SpawnNode(TEXT("Stone"), MakeRow(EResourceType::Stone, 4, 1.f, 2, 0.f, false), FVector(2500.f, -400.f, 0.f));
+	UTribeMemberComponent* M = F.Braves[0]->TribeMember;
+	const int32 First = F.OrderGather(0, Tree);
+	FEconomyFixture::PutAt(F.Braves[0], Tree->GetActorLocation());
+	F.Step(0.25);
+	F.Step(1.1);
+	TestTrue(TEXT("Carrying wood"), M->IsCarrying() && M->GetCarriedType() == EResourceType::Wood);
+
+	// A new order (player command) replaces the task; the bundle stays in hand and goes home first.
+	const int32 Second = F.OrderGather(0, Rock);
+	TestTrue(TEXT("First order cancelled"), F.StateOf(First) == ETribeTaskState::Cancelled);
+	TestTrue(TEXT("Still carrying the wood"), M->IsCarrying() && M->GetCarriedType() == EResourceType::Wood);
+	TestTrue(TEXT("Stone order starts by going home"), F.Execs[0].GetGatherPhase() == EGatherPhase::ToDropOff);
+	FEconomyFixture::PutAt(F.Braves[0], F.FireAt);
+	F.Step(0.25);
+	TestEqual(TEXT("Wood delivered"), F.Wood(), 1);
+	TestTrue(TEXT("Then off to the stone"), F.Execs[0].GetGatherPhase() == EGatherPhase::ToNode && F.Movers[0].LastGoalActor == Rock);
+	F.RunTrip(0, Rock);
+	TestEqual(TEXT("Stone delivered"), F.T0->GetResourceAmount(EResourceType::Stone), 1);
+	TestTrue(TEXT("Stone order still running"), F.StateOf(Second) == ETribeTaskState::Active);
+
+	// A wrong order: a stone tag aimed at a tree fails at once.
+	const int32 Bad = F.T0->CreateTask(FGatherRules::TagForResource(EResourceType::Stone), ETribeTaskPriority::Normal, Tree, Tree->GetActorLocation(), true, TEXT("Test"));
+	F.T0->CancelTask(Second, TEXT("Test"));
+	F.T0->AssignTask(Bad, M);
+	F.T0->StartTask(Bad);
+	TestTrue(TEXT("Mismatched node fails (WrongResource)"), F.StateOf(Bad) == ETribeTaskState::Failed && F.ReasonOf(Bad) == FName(TEXT("WrongResource")));
+	return true;
+}
+
+SHAMAN_ECONOMY_TEST(FShamanEconomyNodeDepletionTest, "Shaman.Economy.NodeDepletion")
+bool FShamanEconomyNodeDepletionTest::RunTest(const FString& Parameters)
+{
+	FEconomyFixture F(0);
+	AResourceNode* Rock = F.SpawnNode(TEXT("Stone"), MakeRow(EResourceType::Stone, 2, 1.f, 1, 0.f, true), FVector(2000.f, 0.f, 0.f));
+	TestEqual(TEXT("First bundle"), Rock->Harvest(1), 1);
+	TestFalse(TEXT("Still standing with 1 left"), Rock->IsPendingKillPending());
+	TestEqual(TEXT("Last bundle"), Rock->Harvest(1), 1);
+	TestTrue(TEXT("Used-up outcrop is removed"), Rock->IsPendingKillPending());
+
+	AResourceNode* Tree = F.SpawnNode(TEXT("Tree"), MakeRow(EResourceType::Wood, 4, 1.f, 2, 90.f, true), FVector(3000.f, 0.f, 0.f));
+	TestEqual(TEXT("Take the whole tree"), Tree->Harvest(10), 4);
+	TestTrue(TEXT("A regrowing tree is never removed"), !Tree->IsPendingKillPending() && Tree->IsDepleted());
+	TestEqual(TEXT("Regrows one bundle per step"), Tree->RegrowStep(), 1);
+	Tree->RegrowStep(); Tree->RegrowStep(); Tree->RegrowStep();
+	TestEqual(TEXT("Back to full"), Tree->Remaining, 4);
+	TestEqual(TEXT("No growth past full"), Tree->RegrowStep(), 0);
+
+	// Regrowth on the world clock: 90 s per bundle.
+	Tree->Harvest(1);
+	F.W.AdvanceTimers(91.f);
+	TestEqual(TEXT("Timer regrew the bundle after 90 s"), Tree->Remaining, 4);
+	return true;
+}
+
+SHAMAN_ECONOMY_TEST(FShamanEconomyProductionDataTest, "Shaman.Economy.ProductionData")
+bool FShamanEconomyProductionDataTest::RunTest(const FString& Parameters)
+{
+	// Fails until Content/Data/Resources.csv and Buildings.csv are reimported (the new 3.1 columns).
+	FTribeTestWorld W;
