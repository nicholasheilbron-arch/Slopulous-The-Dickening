+SHAMAN_ECONOMY_TEST(FShamanEconomyNextNodeTest, "Shaman.Economy.NextNode")
+bool FShamanEconomyNextNodeTest::RunTest(const FString& Parameters)
+{
+	FEconomyFixture F(2);
+	if (!TestEqual(TEXT("Two Braves"), F.Braves.Num(), 2)) return false;
+	// One-slot trees: the second Brave sent to tree A takes tree B; a far tree and a stone are ignored.
+	AResourceNode* A = F.SpawnNode(TEXT("Tree"), MakeRow(EResourceType::Wood, 2, 1.f, 1, 0.f, false), FVector(2500.f, 400.f, 0.f));
+	AResourceNode* B = F.SpawnNode(TEXT("Tree"), MakeRow(EResourceType::Wood, 2, 1.f, 1, 0.f, false), FVector(2500.f, 1400.f, 0.f));
+	AResourceNode* Far = F.SpawnNode(TEXT("Tree"), MakeRow(EResourceType::Wood, 2, 1.f, 1, 0.f, false), FVector(20000.f, 400.f, 0.f));
+	AResourceNode* Rock = F.SpawnNode(TEXT("Stone"), MakeRow(EResourceType::Stone, 2, 1.f, 1, 0.f, false), FVector(2600.f, 600.f, 0.f));
+
+	F.OrderGather(0, A);
+	FEconomyFixture::PutAt(F.Braves[0], A->GetActorLocation());
+	F.Step(0.25);
+	TestTrue(TEXT("Brave 0 works tree A"), F.Execs[0].GetGatherPhase() == EGatherPhase::Harvesting && F.Execs[0].GetGatherNode() == A);
+
+	F.OrderGather(1, A);
+	F.Step(0.25);
+	TestTrue(TEXT("Tree A is full: Brave 1 moves on to tree B"), F.Execs[1].GetGatherNode() == B && F.Movers[1].LastGoalActor == B);
+	TestTrue(TEXT("Never the stone or the far tree"), F.Execs[1].GetGatherNode() != Rock && F.Execs[1].GetGatherNode() != Far);
+
+	// Empty both near trees: the next pick finds only the far one, outside NodeSearchRadius.
+	A->Harvest(10);
+	B->Harvest(10);
+	F.Step(1.1); // Brave 0's work ends on an empty tree: back to looking
+	F.Step(0.25);
+	TestTrue(TEXT("Brave 0 finished: nothing left within the search radius"), !F.Execs[0].HasControl() && !F.Braves[0]->TribeMember->HasTask());
+	TestTrue(TEXT("Brave 1 finished too"), !F.Execs[1].HasControl());
+	TestEqual(TEXT("Far tree untouched"), Far->Remaining, 2);
+	return true;
+}
+
+SHAMAN_ECONOMY_TEST(FShamanEconomyCarrierDeathTest, "Shaman.Economy.CarrierDeath")
+bool FShamanEconomyCarrierDeathTest::RunTest(const FString& Parameters)
+{
+	FEconomyFixture F(1);
+	AResourceNode* Tree = F.SpawnNode(TEXT("Tree"), MakeRow(EResourceType::Wood, 4, 2.f, 1, 0.f, false), FVector(2500.f, 400.f, 0.f));
+	const int32 Id = F.OrderGather(0, Tree);
+	FEconomyFixture::PutAt(F.Braves[0], Tree->GetActorLocation());
+	F.Step(0.25);
+	TestEqual(TEXT("Working: slot held"), Tree->GetGathererCount(), 1);
+
+	F.Braves[0]->Health->Kill(nullptr);
+	TestTrue(TEXT("Death fails the gather task"), F.StateOf(Id) == ETribeTaskState::Failed);
+	TestFalse(TEXT("Executor let go"), F.Execs[0].HasControl());
+	TestEqual(TEXT("Slot freed for others"), Tree->GetGathererCount(), 0);
+	TestEqual(TEXT("Nothing delivered"), F.Wood(), 0);
